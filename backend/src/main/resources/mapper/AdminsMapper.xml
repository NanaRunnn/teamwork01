<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neusoft.nep.mapper.AdminsMapper">

    <resultMap id="BaseResultMap" type="com.neusoft.nep.model.entity.Admins">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
    </resultMap>

    <select id="selectByCodeAndPassword" resultMap="BaseResultMap">
        SELECT id, code, password, real_name FROM admins WHERE code = #{code} AND password = #{password}
    </select>

</mapper>
